                <mxCell id="roles" value="Roles y autenticación&#xa;ADMIN / RECEPCIÓN: acceso total&#xa;PROFESOR: cursos asignados, notas, asistencia, anuncios&#xa;ALUMNO: portal, cursos, notas, pagos, inscripciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1b"><mxGeometry x="40" y="40" width="330" height="150" as="geometry"/></mxCell>
