                <mxCell id="alumno2" value="Alumno&#xa;nombre, apellido, DOB, contacto emergencia&#xa;Validación: email, DNI numérico, edad mínima 4" style="swimlane;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1b"><mxGeometry x="40" y="260" width="300" height="125" as="geometry"/></mxCell>
                <mxCell id="profesor2" value="Profesor&#xa;especialidad&#xa;No puede tener cursos con horarios superpuestos" style="swimlane;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1b"><mxGeometry x="430" y="260" width="280" height="115" as="geometry"/></mxCell>
                <mxCell id="curso2" value="Curso&#xa;nombre, nivel, capacidad máxima, horario&#xa;profesor asignado, prerrequisito" style="swimlane;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1b"><mxGeometry x="820" y="40" width="300" height="125" as="geometry"/></mxCell>
                <mxCell id="inscripcion2" value="Inscripción&#xa;alumno, curso, fecha, estado&#xa;PENDIENTE · CONFIRMADA · EN_CURSO&#xa;FINALIZADA · CANCELADA" style="swimlane;startSize=26;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1b"><mxGeometry x="820" y="260" width="300" height="145" as="geometry"/></mxCell>
                <mxCell id="academico" value="Seguimiento académico&#xa;Calificación: solo ADMIN/PROFESOR&#xa;Asistencia: profesor del curso o ADMIN&#xa;Historial académico y anuncios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1b"><mxGeometry x="40" y="480" width="330" height="125" as="geometry"/></mxCell>
                <mxCell id="pago2" value="Pago&#xa;estado: PENDIENTE / PAGADO / VENCIDO&#xa;PENDIENTE → CONFIRMADA al pagar" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1b"><mxGeometry x="430" y="480" width="280" height="110" as="geometry"/></mxCell>
                <mxCell id="reglas" value="Reglas de negocio&#xa;• No superar capacidad del curso&#xa;• Exigir aprobación del nivel anterior&#xa;• Email y DNI únicos&#xa;• Email válido y DNI solo numérico&#xa;• Nombre, apellido, DOB y emergencia obligatorios&#xa;• Estados de inscripción controlan pagos, cursada y bajas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1b"><mxGeometry x="820" y="480" width="360" height="170" as="geometry"/></mxCell>
